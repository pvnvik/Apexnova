# ==============================================================================
# ApexNova Holding Company — .gitignore
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary and Cache files
*.tmp
*.temp
*.swp
*~
*.bak

# Environment and Logs
*.log
.env
.env.local

# IDE / Editor folders
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Node / Package managers (if any)
node_modules/
npm-debug.log*

# WordPress temporary files & cache
wp-content/cache/
wp-content/upgrade/

# Preserve essential assets, uploads, and backups
!wp-content/uploads/extracted/
!wp-content/backups/
